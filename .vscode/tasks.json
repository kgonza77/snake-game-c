// ONLY COMPILE THE GAME wiht ctrl + shift + b 
// to execute the program run the command ./snake.exe

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Snake Game",
            "type": "shell",
            "command": "gcc",
            "args": [
                "main.c",
                "snake.c",
                "-o",
                "snake.exe",
                "-IC:/msys64/ucrt64/include",
                "-LC:/msys64/ucrt64/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}


