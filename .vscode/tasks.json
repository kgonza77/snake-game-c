// ONLY BUILD THE GAME with Ctrl + Shift + B
// To execute the program, run: .\build\snake.exe

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Snake Game",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}